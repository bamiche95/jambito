# MongoDB Atlas
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"

# MyQuest question provider
MYQUEST_API_KEY=""

# Paystack (secret key is server-only; public key is for the client SDK if used)
PAYSTACK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_PAYSTACK_KEY="pk_test_..."

# Public site URL (used for sitemap / OpenGraph / payment callback)
# Local dev: http://localhost:3000 — Production: https://www.cbtpractice.ng
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Meta (Facebook) Pixel
# The ID is PUBLIC — it ships in the page HTML of every visitor — so it is not a
# secret. lib/metaPixel.ts holds the live ID as its fallback, meaning the pixel
# works when this variable is simply left unset. Setting it to the empty string
# turns the pixel off entirely, which is what you want locally so development
# traffic never lands in the pixel's data. Like every NEXT_PUBLIC_* value it is
# inlined at BUILD time, so a change needs a rebuild/redeploy.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_META_PIXEL_ID="442195429851512"

# ---------------------------------------------------------------------------
# Firebase (client SDK — these are PUBLIC, not secret)
# NOTE: NEXT_PUBLIC_* values are inlined at BUILD time. They must be set for
# every environment you deploy to (e.g. Vercel → Settings → Environment
# Variables, for BOTH Production and Preview) and the app must be rebuilt /
# redeployed afterwards — otherwise the client SDK throws
# `auth/invalid-api-key` at runtime.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

# ---------------------------------------------------------------------------
# Firebase Admin (server — SECRET). Pick ONE, by where the code runs:
#
#   FIREBASE_SERVICE_ACCOUNT
#       The service-account JSON ITSELF (the file's contents, on one line).
#       Required on any deployed host (Vercel). Without it, ID-token
#       verification still works — it only needs the public project ID — but
#       admin actions such as blocking an account cannot be mirrored to
#       Firebase, so the lockout stays MongoDB-only.
#
#   GOOGLE_APPLICATION_CREDENTIALS
#       PATH to the downloaded JSON key file. LOCAL DEVELOPMENT ONLY: the key is
#       gitignored (*-firebase-adminsdk-*.json), so a deployment can never
#       contain it. Setting it on Vercel does nothing except log a warning
#       ("GOOGLE_APPLICATION_CREDENTIALS is a local file path and is ignored
#       here") on every cold start.
#
# So: workstation -> GOOGLE_APPLICATION_CREDENTIALS, deploy -> FIREBASE_SERVICE_ACCOUNT.
# Remove GOOGLE_APPLICATION_CREDENTIALS from the Vercel project entirely (every
# environment, Development included — otherwise `vercel env pull` copies it back
# into .env.local).
#
# Tip: paste the JSON as a single line so `private_key` keeps its "\n" escapes.
# A double-escaped key is repaired at runtime, but a mangled paste is not.
# ---------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT=""
GOOGLE_APPLICATION_CREDENTIALS="./jambito-firebase-adminsdk-fbsvc-b45890dfe9.json"

# Comma-separated emails that get the admin role automatically on sign-in
ADMIN_EMAILS=""

# ---------------------------------------------------------------------------
# Transactional email (the contact@cbtpractice.ng mailbox on Go54)
#
# Go54's documented settings — exactly what this app uses:
#   Outgoing (SMTP): smtp.go54mail.com, port 587, STARTTLS
#                    username = the FULL mailbox address, password = the
#                    password you use to sign in to that mailbox.
#   Incoming (IMAP): imap.go54mail.com, port 993, SSL/TLS — NOT used by this
#                    app. Replies are read in the Go54 webmail or any mail
#                    client; nothing here fetches mail.
#
# SERVER ONLY: these are never sent to the browser, so none of them may be
# prefixed with NEXT_PUBLIC_. Until SMTP_PASSWORD is set:
#   - POST /api/contact answers 503 mail_unconfigured (the form shows the
#     support address as a fallback), and
#   - POST /api/welcome answers 503 and no welcome mail is sent.
# Nothing else breaks, and sign-in still works.
#
# SMTP_PORT 587 = STARTTLS (the transport requires the upgrade, it never falls
# back to plaintext). Use 465 with SMTP_SECURE="true" for implicit TLS.
#
# NOTE (verified against Go54 from this machine): 587 accepts the TCP
# connection and is then reset before the banner — some ISPs, office networks
# and sandboxes block that port. 465 answers normally ("220 ... Ready") and
# returns a proper 535 on a wrong password, so 465 is the reliable choice when
# 587 resets. Setting SMTP_PORT="465" is enough; the transport infers implicit
# TLS from the port and ignores SMTP_SECURE="false".
#
# MAIL_FROM_EMAIL must stay on the mailbox's own domain or Go54 will reject the
# message / receivers will mark it as spoofed.
#
# Check the credentials without sending anything:
#   npm run check:mail
#   npm run check:mail -- --send you@example.com
# ---------------------------------------------------------------------------
SMTP_HOST="smtp.go54mail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="contact@cbtpractice.ng"
SMTP_PASSWORD=""
MAIL_FROM_EMAIL="contact@cbtpractice.ng"
MAIL_FROM_NAME="CBT-Practice"

# Where contact-form messages are delivered (defaults to SMTP_USER)
CONTACT_TO_EMAIL="contact@cbtpractice.ng"

# ---------------------------------------------------------------------------
# Brevo — the transport for every student-facing email
#
# The Go54 mailbox above is a human inbox: it is what the contact form writes to
# and what sends the one-off welcome mail. It is NOT used for campaigns, because
# a shared mailbox starts refusing connections after two to four messages in a
# burst, which is exactly how the progress emails used to fail.
#
# Brevo is an HTTPS API, so a campaign goes out as one request with one
# personalised version per student (`messageVersions`), the provider owns the
# bounce handling, and there is no socket to throttle.
#
#   BREVO_API_KEY        Brevo dashboard -> SMTP & API -> API Keys. SERVER ONLY,
#                        never prefixed with NEXT_PUBLIC_.
#   BREVO_SENDER_EMAIL   must be a verified sender (or on an authenticated
#                        domain) in Brevo, or every send is rejected. Keep it on
#                        cbtpractice.ng and set up SPF/DKIM/DMARC for the domain
#                        first, or internet mail will file these as spam.
#   BREVO_SENDER_NAME    the display name on the From line.
#
# Two things that are not obvious from Brevo's own docs, both seen here:
#   - IP restriction. With an IP allowlist on the account, every request from
#     an unlisted address answers 401 with a message about the IP, which reads
#     like a bad API key. That is the `brevo_ip_blocked` code in the dashboard
#     and in emailLog.error; the fix is the address, not the key. Vercel's
#     egress IPs are not stable, so leave the allowlist off.
#   - Plan limits. The free plan allows 300 messages a day, so the dashboard's
#     daily cap (default 200) is what keeps a run inside it.
#
# In production the three BREVO_* values must be set in Vercel -> Settings ->
# Environment Variables for Production: the morning cron cannot read
# .env.local, and without the key it would quietly use the mailbox instead.
#
# Without BREVO_API_KEY the campaign runner falls back to the Go54 mailbox (the
# old behaviour), so nothing breaks — it just keeps hitting the throttle.
#
# Check the key, the sender and the four campaign templates:
#   npm run check:brevo
#   npm run check:brevo -- --send you@example.com
#   npm run check:brevo -- --templates
#
# The campaign templates themselves are pushed from the dashboard
# (Admin -> Emails -> "Push templates"), because they are rendered from the
# copy in Mongo by lib/brevoTemplates.js.
# ---------------------------------------------------------------------------
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="contact@cbtpractice.ng"
BREVO_SENDER_NAME="CBT-Practice"

# Signs the contact form's short-lived timing token. Any long random string
# (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`).
# Rotating it only invalidates forms that are already open. Falls back to
# SMTP_PASSWORD when unset, so a minimal deployment still works.
CONTACT_TOKEN_SECRET=""

# ---------------------------------------------------------------------------
# Automated progress emails (the admin dashboard's Emails tab)
#
# CRON_SECRET has two jobs:
#   1. It authenticates Vercel Cron calling GET /api/cron/emails. Vercel sends
#      it automatically as "Authorization: Bearer <CRON_SECRET>" when the
#      variable exists on the project (see vercel.json for the 07:00 schedule).
#   2. It is the FALLBACK signing key for unsubscribe links.
#
# EMAIL_UNSUBSCRIBE_SECRET overrides (2) so rotating the cron token does not
# invalidate unsubscribe links already sitting in people's inboxes. Set it.
#
# While neither secret is set, the campaign runner refuses to send: every email
# must carry a working opt-out link. Campaigns are also individually disabled
# until an admin turns them on in the dashboard, and the whole system has a
# pause switch plus a daily cap.
#
# Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Check the current state without sending anything:
#   npm run check:emails
# ---------------------------------------------------------------------------
CRON_SECRET=""
EMAIL_UNSUBSCRIBE_SECRET=""

# ---------------------------------------------------------------------------
# Web Push notifications (VAPID — no Firebase Cloud Messaging, no WhatsApp)
#
# Generate ONE keypair and reuse it for every environment:
#
#   npx web-push generate-vapid-keys
#
# PUSH_VAPID_PUBLIC   the "Public Key" line. Safe to ship to browsers; it is
#                     served to the client by GET /api/push, NOT inlined as a
#                     NEXT_PUBLIC_* value, so rotating it needs no rebuild.
# PUSH_VAPID_PRIVATE  the "Private Key" line. SERVER ONLY. Rotating it makes
#                     every existing subscription undeliverable (the push
#                     services reject a signature from a new key), so treat it
#                     like a password: same value in Development, Preview and
#                     Production, or the same phone stops working when it moves
#                     between deployments.
# PUSH_SUBJECT        a mailto: or https: URL that the push services can use to
#                     complain about abuse, e.g. mailto:contact@cbtpractice.ng.
#
# Where they are needed: Vercel -> Settings -> Environment Variables, for
# Production AND Preview (the cron in Phase 2 runs on Production; the local
# checkout needs them in .env.local before subscribing to anything).
#
# Without the pair the feature is OFF, cleanly: GET /api/push reports
# `configured: false`, the reminder card renders nothing, and /api/health's
# `push` block says so. Nothing else in the app is affected.
#
# Check without sending anything:
#   npm run check:push
# Then install the PWA on a phone, turn reminders on, and press
# "Send a test" on /profile (or Admin -> Push).
# ---------------------------------------------------------------------------
PUSH_VAPID_PUBLIC=""
PUSH_VAPID_PRIVATE=""
PUSH_SUBJECT="mailto:contact@cbtpractice.ng"

